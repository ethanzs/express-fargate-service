# Copy to .env for local development (loaded by `npm run dev`). The defaults
# below match the local Postgres/Valkey from `docker compose up -d` (see
# code/compose.yaml). On Fargate, set these in the scheduled task definition
# instead — compose is never used in production.
NODE_ENV=development
LOG_LEVEL=info
# Service identifier attached to every log line (a dimension for dashboards).
SERVICE_NAME=hydrator-service

# --- RDS Postgres ---
# Everything rides in the connection string. Against RDS append ?sslmode=require.
# On Fargate inject this from Secrets Manager (task definition `secrets`) — it
# contains the database password.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# --- ElastiCache Valkey ---
# Valkey speaks the Redis protocol; use rediss:// when in-transit encryption is
# enabled on the ElastiCache cluster.
VALKEY_URL=redis://localhost:6379

# TTL (seconds) on hydrated cache keys — a safety net so stale entries age out
# if hydration stops running. Keep it above the schedule interval. Default 3600.
# CACHE_TTL_SECONDS=3600

# Hard cap on one run's duration (ms). A hung run exits 1 instead of piling up
# behind the next scheduled invocation. Default 300000 (5 min).
# JOB_TIMEOUT_MS=300000

# Connection timeouts (ms). Defaults 10000.
# DB_CONNECT_TIMEOUT_MS=10000
# CACHE_CONNECT_TIMEOUT_MS=10000
# Release version label on every log line. Baked into the image by the
# release build (scripts/release-images.sh); defaults to "dev" locally.
# SERVICE_VERSION=dev

# --- IAM database auth (AWS only; local dev stays on password auth) ---
# DB_AUTH=iam switches from DATABASE_URL to per-connection RDS auth tokens
# minted via the task role. Terraform sets all of these on Fargate.
# DB_AUTH=password
# DB_HOST=
# DB_PORT=5432
# DB_NAME=app
# DB_USER=
